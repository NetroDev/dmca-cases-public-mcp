{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.dmca/dmca-cases",
  "title": "DMCA.com Cases",
  "description": "DMCA.com takedown cases: list, get, create and update DMCA cases via the DMCA.com API.",
  "websiteUrl": "https://mcp.dmca.com/",
  "icons": [
    {
      "src": "https://mcp.dmca.com/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    },
    {
      "src": "https://mcp.dmca.com/dmca-logo.png",
      "mimeType": "image/png",
      "sizes": [
        "601x189"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/NetroDev/dmca-cases-public-mcp",
    "source": "github"
  },
  "version": "1.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "dmca-cases-mcp",
      "version": "1.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DMCA_API_TOKEN",
          "description": "Your own DMCA.com API token (sent as the Token header to api.dmca.com). Get it from your DMCA.com account API section or the login tool.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.dmca.com/runtime/webhooks/mcp"
    }
  ]
}
