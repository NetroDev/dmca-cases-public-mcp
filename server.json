{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.dmca/dmca-cases",
  "title": "DMCA.com Cases",
  "description": "DMCA.com cases. Your own token via Authorization: Bearer. No function key, no shared token.",
  "websiteUrl": "https://mcp.dmca.com/",
  "icons": [
    {
      "src": "https://mcp.dmca.com/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    },
    {
      "src": "https://mcp.dmca.com/dmca-logo.png",
      "mimeType": "image/png",
      "sizes": [
        "601x189"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/NetroDev/dmca-cases-public-mcp",
    "source": "github"
  },
  "version": "1.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "dmca-cases-mcp",
      "version": "1.2.1",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.dmca.com/runtime/webhooks/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your DMCA.com API token>. Per-caller token from your DMCA.com account API section or the login tool. No function key required.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
